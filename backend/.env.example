# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:3000

# --- Database ---
# MongoDB Atlas or local Mongo. Leave empty to use the built-in local file store (demo mode).
MONGODB_URI=
# Auto-seed demo accounts into the local file store on first start (ignored with MongoDB)
SEED_DEMO=true

# --- Auth ---
# Use a long random string in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Emails that become admins on sign-up (the very first account is always admin)
ADMIN_EMAILS=

# --- AI ---
# anthropic | openai | gateway | demo   (auto-detected from whichever key is set; demo needs no key)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible API works (Groq, OpenRouter, Together, local Ollama...)
OPENAI_BASE_URL=https://api.openai.com/v1

# Vercel AI Gateway (AI_PROVIDER=gateway). On Vercel no key is needed: the
# project's OIDC token is used automatically. Elsewhere set AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-haiku-5.5
# Used when the main model is not on your plan (e.g. the AI Gateway free tier)
AI_GATEWAY_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-free
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=60000
AI_HISTORY_LIMIT=20

# --- Limits ---
RATE_LIMIT_MESSAGES_PER_MIN=20

# Database name inside the cluster (optional; useful when the cluster is shared)
MONGODB_DB=
# Free tools for the AI: web search, web pages, weather, calculator, time, Wikipedia
AI_TOOLS=true
# Optional full web search (free tiers available). Without one, search uses free public APIs.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
